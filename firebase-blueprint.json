{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and Google Account metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Google UID of the authenticated user" },
        "googleId": { "type": "string", "description": "Google Provider ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User full name" },
        "photoURL": { "type": "string", "description": "Google profile photo URL" },
        "role": { "type": "string", "enum": ["farmer", "agronomist", "gardener"] },
        "language": { "type": "string", "description": "Preferred UI language code" },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "lastLoginAt": { "type": "string", "description": "Last sign in ISO date" }
      },
      "required": ["id", "email", "displayName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user records indexed by their Google Auth UID"
    }
  }
}
